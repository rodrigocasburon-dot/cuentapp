# Copia este fichero como .env.local (no se sube a git) y rellena lo que uses.

# Stripe en MODO DE PRUEBAS (D-60). Opcional: sin clave, el cambio de plan es
# simulado y no se cobra. Solo se aceptan claves sk_test_… (una sk_live_ se ignora).
# Se obtiene en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Dirección pública de la app para los enlaces de correos y la vuelta del pago.
# Por defecto http://localhost:3000 (o la de Codespaces).
# CUENTAPP_URL=
